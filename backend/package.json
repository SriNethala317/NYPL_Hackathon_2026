{
  "name": "nypl-benefits-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "tsx tests/run-scenarios.ts",
    "test:mock": "tsx tests/integration/mock-workflow.test.ts",
    "test:gemini:live": "tsx tests/integration/live-gemini-recommendation.check.ts",
    "test:http": "tsx tests/integration/http-api.scenario.ts",
    "test:idnyc:integration": "tsx ../tests/integration/idnyc-form-fill.integration.ts",
    "test:idnyc:mock": "tsx ../tests/integration/idnyc-form-fill.integration.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  }
}
