# Optional: keep disabled unless an approved server-side proxy is available.
EXPO_PUBLIC_GEMINI_ENABLED=false
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash-lite

# Optional live-provider switches. NYC Screening API credentials and endpoint
# require official onboarding and must not be committed.
EXPO_PUBLIC_LIVE_BENEFITS_CATALOG=false
EXPO_PUBLIC_LIVE_BENEFITS_SCREENING=false
EXPO_PUBLIC_BENEFITS_FIXTURE_FALLBACK=true
