# Server-side only. Do not expose Gemini credentials to the Expo client.
GEMINI_ENABLED=false
# Optional. When empty, the resolver selects only an available approved fallback.
GEMINI_MODEL=
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=30000

# Optional live-provider switches. NYC Screening API credentials and endpoint
# require official onboarding and must not be committed.
LIVE_BENEFITS_CATALOG=true
LIVE_BENEFITS_SCREENING=false
BENEFITS_FIXTURE_FALLBACK=true

# Local API transport. Comma-separate multiple allowed local frontend origins.
PORT=3001
FRONTEND_ORIGIN=http://localhost:8081,http://127.0.0.1:8081

# Optional: read the eligibility catalogue from Postgres instead of the bundled generated JSON.
# Off by default -- the JSON path is the long-standing, proven one. Service role key specifically:
# income_eligibility/basic_eligibility_filters/eligibility_rules have RLS enabled with no policies
# at all, so the anon key cannot read them. Never commit a real key here.
DATABASE_BACKED_CATALOGUE=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
