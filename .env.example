# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Supabase (optional) --------------------------------------------------
# Settings → API in your Supabase project. The ANON key is safe in the app
# bundle; every table is row-level-secured and scoped to the signed-in user.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Catalogue push (local scripts only) ----------------------------------
# The SERVICE ROLE key bypasses every row-level policy. It belongs only in your
# shell when running scripts/push-catalogue.mjs — never in EXPO_PUBLIC_*, never
# in the app, never in a commit.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Extraction (optional) ------------------------------------------------
# Without a key the app reads documents with tesseract.js on the web build, and
# cannot read them at all on native — see src/features/extraction/ocr-provider.ts.
#
# With a key, a phone reads documents by sending the photograph to Google's
# Gemini API. That is a real disclosure, not a detail: setting this key changes
# what the privacy screen tells the user, automatically, because the screen is
# generated from the provider that runs. Web keeps using tesseract either way —
# there the image never leaves the browser, which is the better answer.
EXPO_PUBLIC_GEMINI_API_KEY=

# Overrides the model. Only needed when the defaults stop working: Google
# retires model names ("no longer available to new users") and returns 503 on
# busy ones, so src/features/extraction/gemini-vision.ts tries a short list.
# EXPO_PUBLIC_GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Demo applicant (optional).
#
# Only "Load sample" and the demo buttons use these. The camera path reads a
# real document and never touches them.
#
# They exist so nobody has to commit their own name, address and date of birth
# to demo as themselves -- a fixture outlives the demo, and git keeps it
# forever. Leave them unset and an invented person is used instead.
#
# Note these are EXPO_PUBLIC_, so they are inlined into the built app bundle.
# Out of git is not the same as out of the app: anyone with the built binary
# can read them. Fine for a demo on your own phone; do not put anything here
# you would mind a stranger extracting from a shipped build.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_DEMO_NAME=
EXPO_PUBLIC_DEMO_DOB=
EXPO_PUBLIC_DEMO_ADDRESS=
EXPO_PUBLIC_DEMO_HOUSEHOLD=
EXPO_PUBLIC_DEMO_INCOME=
EXPO_PUBLIC_DEMO_SEX=
EXPO_PUBLIC_DEMO_HEIGHT_FEET=
EXPO_PUBLIC_DEMO_HEIGHT_INCHES=
EXPO_PUBLIC_DEMO_EYES=
EXPO_PUBLIC_DEMO_LICENCE_CLASS=
EXPO_PUBLIC_DEMO_ISSUED=
EXPO_PUBLIC_DEMO_EXPIRES=
