  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "check:supabase": "node scripts/check-supabase.mjs",
    "data:ingest": "node scripts/ingest-programs.mjs && node scripts/derive-criteria.mjs"
